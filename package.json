{
    "name":  "mnslff-platform",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "prisma generate \u0026\u0026 node scripts/db-env.mjs prisma migrate deploy \u0026\u0026 node scripts/db-env.mjs npx tsx prisma/seed.ts --if-empty \u0026\u0026 next build",
                    "start":  "next start",
                    "lint":  "eslint",
                    "test":  "vitest run",
                    "db:push":  "node scripts/db-env.mjs prisma migrate deploy",
                    "db:seed":  "tsx prisma/seed.ts",
                    "db:reset":  "prisma migrate reset",
                    "setup":  "node scripts/db-env.mjs prisma migrate deploy \u0026\u0026 tsx prisma/seed.ts",
                    "postinstall":  "prisma generate"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.19.3",
                         "bcryptjs":  "^3.0.3",
                         "clsx":  "^2.1.1",
                         "exceljs":  "^4.4.0",
                         "jose":  "^6.2.18",
                         "lucide-react":  "^1.80.0",
                         "motion":  "^14.14.0",
                         "next":  "16.4.6",
                         "pdf-lib":  "^1.17.1",
                         "prisma":  "^6.19.3",
                         "react":  "19.3.0",
                         "react-dom":  "19.3.0",
                         "recharts":  "^3.11.1",
                         "server-only":  "^0.0.1",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
                            "@tailwindcss/turbopack":  "4.3.3",
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/node":  "^24.19.4",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.4.6",
                            "tailwindcss":  "4.3.3",
                            "tsx":  "^4.23.15",
                            "typescript":  "^5",
                            "vitest":  "^5.1.2"
                        },
    "allowScripts":  {
                         "prisma@6.19.3":  true,
                         "@prisma/client@6.19.3":  true,
                         "@prisma/engines@6.19.3":  true,
                         "esbuild@0.28.2":  true
                     },
    "prisma":  {
                   "seed":  "tsx prisma/seed.ts"
               }
}