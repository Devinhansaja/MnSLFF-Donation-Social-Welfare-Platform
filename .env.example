# ---- Database ----
# Local development uses SQLite. For production use PostgreSQL (e.g. Supabase):
#   1. set provider = "postgresql" in prisma/schema.prisma
#   2. DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DATABASE_URL="file:./dev.db"

# ---- Auth ----
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Payments ----
# The built-in SANDBOX gateway simulates a hosted payment page and sends an
# HMAC-signed webhook. It never moves real money.
SANDBOX_WEBHOOK_SECRET="change-me-sandbox-webhook-secret"

# Real providers stay disabled until merchant approval. Fill these in, then
# enable the gateway in Admin > Payment Gateway Settings.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
SAMPATH_IPG_MERCHANT_ID=""
SAMPATH_IPG_SECRET=""
COMBANK_IPG_MERCHANT_ID=""
COMBANK_IPG_SECRET=""
WEBXPAY_PUBLIC_KEY=""
WEBXPAY_SECRET=""
DIRECTPAY_MERCHANT_ID=""
DIRECTPAY_SECRET=""

# ---- Email ----
# When empty, emails are written to the server log instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="MnSLFF <donations@example.org>"
