# ---- Database (PostgreSQL) ----
# Free options: Neon (neon.tech), Supabase, or Vercel's Postgres/Neon integration.
# DATABASE_URL: the pooled connection string (Neon: host contains "-pooler").
# DIRECT_URL:   the direct, non-pooled string (used to run migrations).
# If your provider gives only one string, use it for both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: an EMPTY throwaway database for `npm test` database tests (rows get deleted).
# TEST_DATABASE_URL=""

# ---- Auth ----
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Deployed sites only: if set (10+ chars), the first build loads demo data into an
# EMPTY database and gives every demo account THIS password instead of the public
# README ones. Remove it after the first successful deploy if you like.
SEED_ADMIN_PASSWORD=""

# ---- Site ----
# Optional. If empty, the site uses the domain of the incoming request.
NEXT_PUBLIC_SITE_URL=""

# ---- Payments ----
# The built-in SANDBOX gateway simulates a hosted payment page and sends an
# HMAC-signed webhook. It never moves real money.
SANDBOX_WEBHOOK_SECRET="change-me-sandbox-webhook-secret"

# Real providers stay disabled until merchant approval. Fill these in, then
# enable the gateway in Admin > Payment Gateway Settings.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
SAMPATH_IPG_MERCHANT_ID=""
SAMPATH_IPG_SECRET=""
COMBANK_IPG_MERCHANT_ID=""
COMBANK_IPG_SECRET=""
WEBXPAY_PUBLIC_KEY=""
WEBXPAY_SECRET=""
DIRECTPAY_MERCHANT_ID=""
DIRECTPAY_SECRET=""

# ---- Email ----
# When empty, emails are written to the server log instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="MnSLFF <donations@example.org>"
